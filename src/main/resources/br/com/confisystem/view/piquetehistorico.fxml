<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="br.com.confisystem.controller.PiqueteHistoricoController"
        stylesheets="@styles.css"
        prefWidth="720" prefHeight="520">

    <top>
        <VBox styleClass="page-header">
            <Label fx:id="lblTitulo" text="Histórico de Tratos" styleClass="page-header-title"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="page-content" spacing="14">

            <TableView fx:id="tabelaHistorico" VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colData" text="Data" prefWidth="100"/>
                    <TableColumn fx:id="colRacao" text="Ração" prefWidth="180"/>
                    <TableColumn fx:id="colQuantidade" text="Quantidade" prefWidth="120"/>
                    <TableColumn fx:id="colSituacao" text="Duração do Ciclo" prefWidth="130"/>
                    <TableColumn fx:id="colConsumoMedio" text="Consumo Médio" prefWidth="130"/>

                </columns>

            </TableView>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 14 24;">
            <Button fx:id="btnFechar" text="Fechar" styleClass="btn-secondary" onAction="#fechar"/>
        </HBox>
    </bottom>

</BorderPane>
